      <column caption='AVG temp' datatype='real' name='[Calculation_0115782054653952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([temperature_mean_c (weather.csv)])' />
      </column>
      <column caption='max temp' datatype='real' name='[Calculation_0115782064275457]' role='measure' type='quantitative'>

    <worksheet name='Summer temp'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Benton Sans Book' fontsize='10'>Seasonal Temperature Trends</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='locations_clean+' name='federated.1j9qd3t01qob8y1cftrih18sft3u' />
          </datasources>
          <datasource-dependencies datasource='federated.1j9qd3t01qob8y1cftrih18sft3u'>
            <column caption='Summer Temp' datatype='real' name='[Calculation_0588026557861889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, [date (weather.csv)]) IN (6, 7, 8)&#13;&#10;THEN [temperature_mean_c (weather.csv)]&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_0588026557861889]' derivation='Avg' name='[avg:Calculation_0588026557861889:qk]' pivot='key' type='quantitative' />
            <column caption='Date' datatype='date' name='[date (weather.csv)]' role='dimension' type='ordinal' />
            <column caption='Temperature Mean C' datatype='real' name='[temperature_mean_c (weather.csv)]' role='measure' type='quantitative' />
            <column-instance column='[date (weather.csv)]' derivation='Year' name='[yr:date (weather.csv):ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>

          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.1j9qd3t01qob8y1cftrih18sft3u].[avg:Calculation_0588026557861889:qk]' field-type='quantitative' max='27.0' min='23.0' range-type='fixed' scope='rows' type='space' />
            <format attr='stroke-color' scope='rows' value='#75a1c7' />
            <format attr='tick-color' scope='rows' value='#75a1c7' />
            <format attr='stroke-color' scope='cols' value='#75a1c7' />
            <format attr='tick-color' scope='cols' value='#75a1c7' />
            <format attr='title' class='0' field='[federated.1j9qd3t01qob8y1cftrih18sft3u].[avg:Calculation_0588026557861889:qk]' scope='rows' value='Summer        Mean' />
            <format attr='width' field='[federated.1j9qd3t01qob8y1cftrih18sft3u].[avg:Calculation_0588026557861889:qk]' value='92' />

      </column>
      <column caption='Season' datatype='string' name='[Calculation_0588026551144448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATEPART(&apos;month&apos;, [date (weather.csv)])&#13;&#10;&#13;&#10;    WHEN 12 THEN &quot;Winter&quot;&#13;&#10;    WHEN 1 THEN &quot;Winter&quot;&#13;&#10;    WHEN 2 THEN &quot;Winter&quot;&#13;&#10;&#13;&#10;    WHEN 3 THEN &quot;Spring&quot;&#13;&#10;    WHEN 4 THEN &quot;Spring&quot;&#13;&#10;    WHEN 5 THEN &quot;Spring&quot;&#13;&#10;&#13;&#10;    WHEN 6 THEN &quot;Summer&quot;&#13;&#10;    WHEN 7 THEN &quot;Summer&quot;&#13;&#10;    WHEN 8 THEN &quot;Summer&quot;&#13;&#10;&#13;&#10;    WHEN 9 THEN &quot;Autumn&quot;&#13;&#10;    WHEN 10 THEN &quot;Autumn&quot;&#13;&#10;    WHEN 11 THEN &quot;Autumn&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Summer Temp' datatype='real' name='[Calculation_0588026557861889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, [date (weather.csv)]) IN (6, 7, 8)&#13;&#10;THEN [temperature_mean_c (weather.csv)]&#13;&#10;END' />
      </column>
      <column caption='Winter Temp' datatype='real' name='[Calculation_0588026558042114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([date (weather.csv)]) = 12&#13;&#10;OR MONTH([date (weather.csv)]) = 1&#13;&#10;OR MONTH([date (weather.csv)]) = 2&#13;&#10;THEN [temperature_mean_c (weather.csv)]&#13;&#10;END' />
      </column>
      <column caption='Winter Year' datatype='integer' name='[Calculation_0588026558144515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([date (weather.csv)]) = 12 THEN&#13;&#10;    YEAR([date (weather.csv)]) + 1&#13;&#10;ELSE&#13;&#10;    YEAR([date (weather.csv)])&#13;&#10;END' />
      </column>
      <column caption='Avg temp by years' datatype='real' name='[Calculation_0588026575151109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED YEAR([date (weather.csv)]) :&#13;&#10;    AVG([temperature_mean_c (weather.csv)])}' />
      </column>
      <column caption='Top 5 warmest' datatype='boolean' name='[Calculation_0588026575437830]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(&#13;&#10;    MIN([Calculation_0588026575151109]),&#13;&#10;    &apos;desc&apos;&#13;&#10;) &lt;= 5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top 5 coldest' datatype='boolean' name='[Calculation_0588026576285703]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(&#13;&#10;    MIN([Calculation_0588026575151109]),&#13;&#10;    &apos;asc&apos;&#13;&#10;) &lt;= 5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Temp &gt;30' datatype='integer' name='[Calculation_0588026594639880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED YEAR([date (weather.csv)]) :&#13;&#10;    COUNTD(&#13;&#10;        IF [temperature_mean_c (weather.csv)] &gt; 30&#13;&#10;        THEN [date (weather.csv)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Max Avg temp' datatype='real' name='[Calculation_0636402285375488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX([Calculation_1791989015965696]) }' />
      </column>
      <column caption='Min Avg Temp' datatype='real' name='[Calculation_0636402285682689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MIN([Calculation_1791989015965696]) }' />
      </column>
      <column caption='Regional Avg Temp' datatype='real' datatype-customized='true' name='[Calculation_1791989015965696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region] : AVG([temperature_mean_c (weather.csv)]) }' />
      </column>
      <column caption='Hottest Region' datatype='string' name='[Calculation_1791989018255361]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1791989015965696] = [Calculation_0636402285375488]&#13;&#10;THEN [region]&#13;&#10;END' />
      </column>
      <column caption='Coldest Region' datatype='string' name='[Calculation_1791989018402818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1791989015965696] = [Calculation_0636402285682689]&#13;&#10;THEN [region]&#13;&#10;END' />
      </column>
